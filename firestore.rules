rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read & write for users and categories to enable seamless registration and referral checks
    match /users/{userId} {
      allow read, write: if true;
    }
    match /dealers/{userId} {
      allow read, write: if true;
    }
    match /architects/{userId} {
      allow read, write: if true;
    }
    match /builders/{userId} {
      allow read, write: if true;
    }
    match /wholesalers/{userId} {
      allow read, write: if true;
    }
    match /retailers/{userId} {
      allow read, write: if true;
    }
    match /salesPersons/{spId} {
      allow read, write: if true;
    }
    match /client_assignments/{assignmentId} {
      allow read, write: if true;
    }
    match /assigned_clients/{assignmentId} {
      allow read, write: if true;
    }

    // Products catalog and feature flags (public read & write access)
    match /products/{productId} {
      allow read, write: if true;
    }
    match /tiles/{tileId} {
      allow read, write: if true;
    }
    match /categories/{catId} {
      allow read, write: if true;
    }
    match /systemConfigs/{configId} {
      allow read, write: if true;
    }

    // Default rule for all remaining collections (orders, shipments, carts, etc.)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
