rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if request payload contains sensitive password/credential fields
    function hasSensitiveFields(requestData) {
      return ('password' in requestData) ||
             ('pass' in requestData) ||
             ('hash' in requestData) ||
             ('token' in requestData);
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if requesting user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if request payload attempts to supply trusted reward fields directly
    function hasRewardFields(requestData) {
      return ('loyaltyPoints' in requestData) ||
             ('lifetimePoints' in requestData) ||
             ('welcomeBonusGranted' in requestData) ||
             ('referredBy' in requestData);
    }

    // Helper function to check if request is modifying privileged fields (role, userCategory, or reward balances)
    function isModifyingPrivilegedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'userCategory', 'loyaltyPoints', 'lifetimePoints', 'welcomeBonusGranted', 'referredBy']);
    }

    // Users Collection Security Rules:
    // - Enforce no password, pass, hash, or token fields allowed in payload.
    // - Disallow client control over trusted reward fields on creation (initialized exclusively by Cloud Functions).
    // - Privileged fields (role, userCategory, loyaltyPoints, etc.) can only be updated by admins or backend functions.
    match /users/{userId} {
      allow read: if isOwner(userId) || (isAuthenticated() && request.auth.token.admin == true) || true;

      allow create: if !hasSensitiveFields(request.resource.data) &&
        !hasRewardFields(request.resource.data);

      allow update: if !hasSensitiveFields(request.resource.data) &&
        (!isModifyingPrivilegedFields() || (isAuthenticated() && request.auth.token.admin == true));

      allow delete: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Customer Rewards & Loyalty System Rules:
    // Remote reward configuration is readable by all authenticated clients, writeable only by admin
    match /loyaltyConfig/{configId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Loyalty Transactions ledger: read-only for document owner, clients CANNOT create or modify directly
    match /loyaltyTransactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow write: if false; // Writes restricted to Admin SDK / Cloud Functions
    }

    // Customer Referrals: read-only for referrer or referred partner, clients cannot directly manipulate statuses
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerUid == request.auth.uid ||
        resource.data.referredUid == request.auth.uid ||
        request.auth.token.admin == true
      );
      allow write: if false; // Controlled exclusively by backend Cloud Functions
    }

    // Loyalty Redemptions: read-only for document owner. Direct client creation/update is disallowed.
    // Clients must invoke the authoritative submitLoyaltyRedemptionCallable to verify balances and reserve points.
    match /loyaltyRedemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      allow write: if false; // Direct client writes disallowed; created and managed exclusively by Cloud Functions
    }

    // Category collections (dealers, architects, builders, wholesalers, retailers)
    match /dealers/{userId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }
    match /architects/{userId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }
    match /builders/{userId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }
    match /wholesalers/{userId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }
    match /retailers/{userId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }

    // Salespersons and client assignment collections
    match /salesPersons/{spId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }
    match /client_assignments/{assignmentId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }
    match /Auto_Assign_User/{docId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }
    match /Manual_salesperson_assign/{docId} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }

    // Products catalog and feature flags
    match /products/{productId} {
      allow read, write: if true;
    }
    match /tiles/{tileId} {
      allow read, write: if true;
    }
    match /categories/{catId} {
      allow read, write: if true;
    }
    match /systemConfigs/{configId} {
      allow read, write: if true;
    }

    // Default rule for all remaining collections (orders, shipments, carts, etc.)
    match /{document=**} {
      allow read, write: if !hasSensitiveFields(request.resource.data);
    }
  }
}
