rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ITACON Product catalog images (tiles, mockups, adhesives)
    // Read-only access for catalog images so all ITACON app users (including phone/custom session users) can view products
    // Client writes are strictly forbidden
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // User profile photos uploaded from ITACON app
    match /user_profiles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
