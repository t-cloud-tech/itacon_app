rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminOrManager() {
      return isAuthenticated() && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        (('role' in request.auth.token) && request.auth.token.role in ['admin', 'manager']) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && (
          (('role' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data) &&
           firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager']) ||
          (('userCategory' in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data) &&
           firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userCategory in ['admin', 'manager'])
        ))
      );
    }

    function isStaff() {
      return isAdminOrManager();
    }

    function isOwnerProfilePhoto(fileName) {
      return fileName.matches('^' + request.auth.uid + '(_.*)?\\.(jpg|jpeg|png|webp)$');
    }

    function isValidProfilePhotoSize() {
      return request.resource.size <= 5 * 1024 * 1024; // 5 MB maximum
    }

    function isValidProfilePhotoMimeType() {
      return request.resource.contentType.matches('image/jpeg') ||
             request.resource.contentType.matches('image/jpg') ||
             request.resource.contentType.matches('image/png') ||
             request.resource.contentType.matches('image/webp');
    }

    function isValidReceiptMimeType() {
      return request.resource.contentType.matches('image/jpeg') ||
             request.resource.contentType.matches('image/jpg') ||
             request.resource.contentType.matches('image/png') ||
             request.resource.contentType.matches('image/webp') ||
             request.resource.contentType.matches('application/pdf');
    }

    function isValidReceiptSize() {
      return request.resource.size <= 10 * 1024 * 1024; // 10 MB maximum
    }

    function isDeterministicReceiptName(fileName) {
      return fileName.matches('receipt(_[0-4])?\\.(jpg|jpeg|png|webp|pdf)');
    }

    // ITACON Product catalog images (tiles, mockups, adhesives)
    // Read-only access for catalog images so all ITACON app users can view products
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // User profile photos uploaded from ITACON app
    // Stored under user_profiles/{fileName}
    match /user_profiles/{fileName} {
      // 1. Existing profile photos remain readable for all app users
      allow read: if true;

      // 2. Profile photo creation and updates (owner or admin/manager):
      //    - Must be authenticated
      //    - Allowed for photo owner or authorized admin/manager
      //    - ALL uploads (including admin/manager) must strictly comply with:
      //        * Max file size: 5 MB
      //        * Supported image MIME types: image/jpeg, image/jpg, image/png, image/webp
      allow create, update: if isAuthenticated() &&
        isValidProfilePhotoSize() &&
        isValidProfilePhotoMimeType() &&
        (isAdminOrManager() || isOwnerProfilePhoto(fileName));

      // 3. Profile photo deletion (owner-only or admin/manager):
      //    - Customer can delete their own photo (or admin/manager)
      //    - Customer cannot delete another user's photo
      //    - Note: In Firebase Storage rules, request.resource is null on delete operations,
      //      so size and MIME validations must NOT be checked on delete!
      allow delete: if isAuthenticated() && (
        isAdminOrManager() ||
        isOwnerProfilePhoto(fileName)
      );
    }

    // SECURE PRIVATE PAYMENT PROOFS
    // Stored privately under payment_proofs/{orderId}/{submissionId}/{fileName}
    // Only the order owner, assigned salesperson, or admin/manager can access the file.
    // Public download is strictly prohibited.
    match /payment_proofs/{orderId}/{submissionId}/{fileName} {
      // Read access: owner of the order, assigned salesperson, or admin/manager
      allow read: if isAuthenticated() && (
        isStaff() ||
        (('userId' in firestore.get(/databases/(default)/documents/orders/$(orderId)).data) &&
         firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid) ||
        (('salesPersonId' in firestore.get(/databases/(default)/documents/orders/$(orderId)).data) &&
         firestore.get(/databases/(default)/documents/orders/$(orderId)).data.salesPersonId == request.auth.uid)
      );

      // Create access:
      // 1. Authenticated customer who owns the order
      // 2. Strict deterministic filename: receipt.(jpg|jpeg|png|webp|pdf)
      // 3. File size must be <= 10 MB
      // 4. Approved MIME types only (JPEG, PNG, WEBP, PDF)
      allow create: if isAuthenticated() &&
        (('userId' in firestore.get(/databases/(default)/documents/orders/$(orderId)).data) &&
         firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid) &&
        isDeterministicReceiptName(fileName) &&
        isValidReceiptSize() &&
        isValidReceiptMimeType();

      // Overwrite protection: customer can NEVER replace proof once uploaded
      allow update: if false;

      // Audit trail protection: customer can NEVER delete proof once uploaded
      allow delete: if false;
    }

    // SECURE OFFICIAL PURCHASE ORDERS
    // 1. Confirmed PO estimate: purchase_orders/{fileName} (public read for legacy / confirmed PO)
    match /purchase_orders/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Official Paid PO: purchase_orders/{orderId}/{fileName}
    //    Private access: strictly restricted to owning customer or authorized staff (admin/manager or assigned salesperson).
    match /purchase_orders/{orderId}/{fileName} {
      allow read: if isAuthenticated() && (
        isAdminOrManager() ||
        (('userId' in firestore.get(/databases/(default)/documents/orders/$(orderId)).data) &&
         firestore.get(/databases/(default)/documents/orders/$(orderId)).data.userId == request.auth.uid) ||
        (('customerId' in firestore.get(/databases/(default)/documents/orders/$(orderId)).data) &&
         firestore.get(/databases/(default)/documents/orders/$(orderId)).data.customerId == request.auth.uid) ||
        (('salesPersonId' in firestore.get(/databases/(default)/documents/orders/$(orderId)).data) &&
         firestore.get(/databases/(default)/documents/orders/$(orderId)).data.salesPersonId == request.auth.uid) ||
        (('salespersonId' in firestore.get(/databases/(default)/documents/orders/$(orderId)).data) &&
         firestore.get(/databases/(default)/documents/orders/$(orderId)).data.salespersonId == request.auth.uid)
      );
      // Strictly no client-side create, overwrite or delete: trusted Cloud Functions only!
      allow write: if false;
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
